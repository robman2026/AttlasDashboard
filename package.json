{
  "name": "atlas-home-dashboard",
  "version": "0.1.0",
  "description": "ATLAS Home - custom Home Assistant dashboard strategy (Lit, HACS)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "docs": "node scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run icons && npm run docs && tsc --noEmit && vite build",
    "screenshots": "node scripts/screenshots.mjs",
    "harness": "vite --config vite.dev.config.ts --open /dev/harness.html?view=home"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "home-assistant-js-websocket": "^9.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
